# -----------------------------------------------------------------------------
# NEOGIT CONFIGURATION IGNORE
# This file excludes files generated by Neovim, Lua, and specific plugins
# -----------------------------------------------------------------------------

# 1. Neovim's Core Data Directory
# Exclude the entire 'data' directory created by Neovim (vim.fn.stdpath("data"))
# This contains compiled files, swap files, and undo history.
# Typical paths: ~/.local/share/nvim/ or ~/Library/Caches/Neovim/
**/.local/share/nvim/
**/lazy/lazy.nvim/
**/lazy/
**/lazy-lock.json

# 2. Lua/Compiled Files
# Exclude compiled Lua files (bytecode)
*.lua.c

# 3. Swap, Backup, and Undo Files
# Exclude temporary files created by Neovim while editing
*.swp
*.swo
*~
*.bak
.netrwhist  # History file for the built-in netrw
.DS_Store   # macOS metadata files

# 4. Plugin Manager Data
# Exclude data directories for common plugin managers
# (If you don't use these, you can delete them, but they're safe to keep)
packer_compiled.lua
**/plugged/
**/pckr.nvim/

# 5. Mason and Language Server Tools
# Exclude the Mason installation directory and its generated links/files
# This is where LSP servers, formatters, etc., are installed.
.mason/
mason/
mason-registry/

# 6. Specific Plugin Data (Examples)
# Exclude files that store state or cache for popular plugins
# Adjust these based on the plugins you use.
telescope-media-files.nvim